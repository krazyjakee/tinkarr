# Tinkarr Docker Environment Configuration
# Copy this file to .env and update the values

# ============================================
# Security Settings
# ============================================

# JWT Secret - MUST CHANGE IN PRODUCTION!
# Generate a secure random string (e.g., openssl rand -base64 32)
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# JWT Token Expiration (e.g., 7d, 24h, 30m)
JWT_EXPIRES_IN=7d

# ============================================
# Application Settings
# ============================================

# Server Port (internal - mapped via docker-compose.yml)
PORT=3000

# Node Environment
NODE_ENV=production

# ============================================
# Database Settings
# ============================================

# Database file path (inside container)
DATABASE_URL=file:/app/data/tinkarr.db

# ============================================
# Flaresolverr Settings
# ============================================

# Flaresolverr URL (Docker service name)
FLARESOLVERR_URL=http://flaresolverr:8191

# Enable/Disable Flaresolverr
FLARESOLVERR_ENABLED=true

# ============================================
# Cache Settings
# ============================================

# Cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Maximum results per indexer
MAX_RESULTS_PER_INDEXER=100

# Global timeout in milliseconds
GLOBAL_TIMEOUT_MS=30000

# ============================================
# Logging Settings
# ============================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info
